# Supabase Cloud Configuration (Optional)
# If provided, BRIDGE automatically persists pre-dispatch shipments & customer interventions to your Supabase PostgreSQL database.
# If omitted, BRIDGE automatically uses local SQLite persistence (data/bridge_local.db).

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
PORT=8000
