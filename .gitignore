# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables & secrets
.env
.env.*
!.env.example

# IDE & Editor settings
.ipynb_checkpoints/
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs and runtime traces
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Datasets (never commit full raw or processed datasets to public repo)
*.xlsx
data/raw/*
data/*.csv
!data/sample_test_deliveries.csv
data/processed/*.csv
data/processed/*.parquet
!data/processed/.gitkeep

# Models & Weights (never commit large serialized artifacts to git)
models/*
!models/.gitkeep

# Serialization binaries
*.pkl
*.joblib
*.h5

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
